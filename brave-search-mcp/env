# Copy to .env and fill in the key.
# Get one at https://api-dashboard.search.brave.com/app/keys

BRAVE_API_KEY=

# --- Compose-level settings ---------------------------------------------------
# Image tag. See https://hub.docker.com/r/brave/brave-search-mcp-server/tags
VERSION=v2.1.3
# Host port. Container always listens on 8080.
BRAVE_PORT=8081
# 0.0.0.0 publishes on all interfaces. Use 127.0.0.1 to keep it local-only.
BIND_HOST=0.0.0.0

# --- Optional -----------------------------------------------------------------
# debug, info, notice, warning, error, critical, alert, emergency
BRAVE_MCP_LOG_LEVEL=info
# Stateless HTTP mode. Keep true unless you need session affinity.
BRAVE_MCP_STATELESS=true

# Tool whitelist / blacklist, space-separated. Set only one of the two.
# BRAVE_MCP_ENABLED_TOOLS=brave_web_search brave_news_search
# BRAVE_MCP_DISABLED_TOOLS=brave_image_search brave_video_search
